#!/bin/sh
# -----------------------------------------------------------------------------
# CryptoShred Health — Pre-Commit Secret & Security Protection Hook
# -----------------------------------------------------------------------------
# Prevents accidental commits of:
#   1. Sensitive files (.env, .pem, .key, id_rsa, service account credentials)
#   2. Hardcoded secret patterns (Private keys, AWS/GCP tokens, literal passwords)
# -----------------------------------------------------------------------------

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

VIOLATIONS=0

echo "${BLUE}🔍 Running pre-commit security check...${NC}"

# 1. Check for blocked file patterns in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
    for file in $STAGED_FILES; do
        # Check against sensitive file patterns
        case "$file" in
            *.env|*.env.*|*/.env|*/.env.*)
                echo "${RED}❌ [SECURITY VIOLATION] Staged sensitive environment file:${NC} $file"
                echo "   -> .env files must never be committed. Secrets belong in git-ignored local .env."
                VIOLATIONS=$((VIOLATIONS + 1))
                ;;
            *.pem|*.p12|*.pfx|*.jks)
                echo "${RED}❌ [SECURITY VIOLATION] Staged certificate/keystore file:${NC} $file"
                VIOLATIONS=$((VIOLATIONS + 1))
                ;;
            *id_rsa*|*id_ed25519*|*id_ecdsa*|*id_dsa*)
                echo "${RED}❌ [SECURITY VIOLATION] Staged SSH private key file:${NC} $file"
                VIOLATIONS=$((VIOLATIONS + 1))
                ;;
            *firebase-adminsdk*.json|*service-account*.json)
                echo "${RED}❌ [SECURITY VIOLATION] Staged cloud service account key:${NC} $file"
                VIOLATIONS=$((VIOLATIONS + 1))
                ;;
        esac
    done
fi

# 2. Check for secret patterns in staged content (excluding deleted lines)
STAGED_DIFF=$(git diff --cached -U0)

if [ -n "$STAGED_DIFF" ]; then
    # Helper to scan for regex pattern in added lines
    check_pattern() {
        local pattern="$1"
        local desc="$2"
        local matches
        matches=$(echo "$STAGED_DIFF" | grep -E '^\+[^+]' | grep -E "$pattern" || true)
        if [ -n "$matches" ]; then
            echo "${RED}❌ [SECURITY VIOLATION] Detected $desc in staged diff:${NC}"
            echo "$matches" | head -n 5 | sed 's/^/   /'
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    }

    # Check for Private Key headers
    check_pattern "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----" "Cryptographic Private Key header"

    # Check for AWS Access Keys
    check_pattern "AKIA[0-9A-Z]{16}" "AWS Access Key ID"

    # Check for Google API Keys
    check_pattern "AIza[0-9A-Za-z_-]{35}" "Google API Key"

    # Check for Slack / Discord webhooks & tokens
    check_pattern "https://hooks.slack.com/services/T[a-zA-Z0-9_]+/B[a-zA-Z0-9_]+/[a-zA-Z0-9_]+" "Slack Incoming Webhook URL"
    check_pattern "ghp_[0-9a-zA-Z]{36}" "GitHub Personal Access Token"

    # Check for hardcoded password assignments without ${VAR} in docker-compose / properties
    check_pattern "POSTGRES_PASSWORD:\s*['\"]?[a-zA-Z0-9!@#%^&*_-]{3,}['\"]?\s*$" "Hardcoded POSTGRES_PASSWORD literal"
    check_pattern "spring\.datasource\.password=[a-zA-Z0-9!@#%^&*_-]+" "Hardcoded spring.datasource.password literal"
    check_pattern "app\.jwt\.secret=[a-zA-Z0-9+/=_-]{16,}" "Hardcoded app.jwt.secret literal"
fi

# 3. If GitGuardian ggshield is available, run it as secondary deep scanner
if command -v ggshield >/dev/null 2>&1; then
    echo "${BLUE}🛡️ Running GitGuardian (ggshield) staged scan...${NC}"
    if ! ggshield secret scan pre-commit; then
        echo "${RED}❌ GitGuardian ggshield flagged potential secrets.${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
elif command -v gitleaks >/dev/null 2>&1; then
    echo "${BLUE}🛡️ Running Gitleaks staged scan...${NC}"
    if ! gitleaks protect --staged --verbose; then
        echo "${RED}❌ Gitleaks flagged potential secrets.${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
fi

# 4. Result evaluation
if [ "$VIOLATIONS" -gt 0 ]; then
    echo ""
    echo "${RED}🛑 COMMIT ABORTED: $VIOLATIONS security violation(s) detected.${NC}"
    echo "Please remove the flagged secrets/files before committing."
    echo "If this is a confirmed false positive, you can bypass with: ${YELLOW}git commit --no-verify${NC}"
    exit 1
fi

echo "${GREEN}✅ Security checks passed. Safe to commit!${NC}"
exit 0
