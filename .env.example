# ── Environment & Secrets Template ─────────────────────────────────────────
# Copy this file to '.env' and populate with real local credentials.
# Do NOT commit '.env' to version control.

# PostgreSQL Configuration
POSTGRES_USER=root
POSTGRES_PASSWORD=toor
