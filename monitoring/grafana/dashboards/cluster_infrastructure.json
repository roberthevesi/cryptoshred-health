      "title": "🧠 JVM Memory Zeroization & Garbage Collection",
      "type": "row"
    },
    {
      "id": 1,
      "title": "JVM Heap Memory Allocation",
      "type": "timeseries",
      "description": "Verifies that scoped byte[] memory zeroization leaves no residual heap leaks",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{area=\"heap\"}",
          "legendFormat": "Heap Committed",
          "refId": "B"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Heap Max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 2,
      "title": "JVM Garbage Collection Pause Times (ms)",
      "type": "timeseries",
      "description": "Garbage collector pause durations in milliseconds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "(rate(jvm_gc_pause_seconds_sum[1m]) / rate(jvm_gc_pause_seconds_count[1m])) * 1000",
          "legendFormat": "GC Pause ({{action}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      }
    },
    {
