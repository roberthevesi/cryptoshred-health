    {
      "id": 12,
      "title": "PostgreSQL Transaction Throughput (Commits / Rollbacks / Sec)",
      "type": "timeseries",
      "description": "Transaction commits and rollbacks rate from postgres-exporter",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"healthdb\"}[1m]) or rate(pg_stat_database_xact_commit[1m])",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"healthdb\"}[1m]) or rate(pg_stat_database_xact_rollback[1m])",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ops"
        }
